  },
  "cohort": {
    "definition": "drafts with a 100+ prior-games bucket in the top 15% of earliest-game Arena rank tiers; stable draft-id tie-break within a tier",
    "minimum_games_bucket_lower_bound": 100,
    "experienced_drafts": 45234,
    "training_drafts": 5000,
    "training_picks": 219075,
    "selection_metric": "earliest_game_arena_rank",
    "top_fraction": 0.15,
    "arena_rank_cutoff_tier": "diamond",
