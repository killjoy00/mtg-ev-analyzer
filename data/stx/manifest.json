      "mythic": 4535,
      "diamond": 12728,
      "platinum": 33281,
      "gold": 15324,
      "silver": 7116,
      "bronze": 2279
    },
    "selection_note": "Legacy cohort uses Arena rank and anonymized prior-games history from each draft's earliest game row. That row is selected before reading any game outcome; wins, losses, event records, and later rank changes are excluded from cohort selection.",
    "skill_sources": [
      {
        "provider": "17Lands",
        "dataset_kind": "game_data",
        "data_date": "2024-01-11",
        "join_key": "draft_id",
        "row_selection": "earliest game_time per draft; file order fallback",
        "fields": [
          "rank",
          "user_n_games_bucket"
        ],
        "purpose": "Arena rank tier and anonymized prior-games experience bucket"
      }
    ]
  },
  "model": {
    "model_version": "strong-player-pool-context-v2",
    "holdout": "5-fold by draft_id",
    "probabilities_are_calibrated": false,
    "description": "Hierarchical strong-player pick tendency adjusted by shrinkage-weighted card/pool co-pick lift; normalized within each pack.",
    "pool_conditioned": true
  },
