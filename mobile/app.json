{
  "expo": {
    "name": "Pack One",
    "slug": "pack-one",
    "version": "1.0",
    "orientation": "default",
    "scheme": "packone",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.packone.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "pro.packone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#1e4d7a"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "description": "Practice real draft decisions, compare trophy picks, and track your Pack One career.",
    "backgroundColor": "#f7f8fa"
  }
}
