{
  "expo": {
    "name": "Pack One",
    "slug": "pack-one",
    "version": "1.0",
    "orientation": "default",
    "scheme": "packone",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.packone.app",
      "usesAppleSignIn": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "pro.packone.app"
    },
    "description": "Practice real draft decisions, compare trophy picks, and track your Pack One career.",
    "backgroundColor": "#f7f8fa"
  }
}
