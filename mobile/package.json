{
  "name": "pack-one-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "config:check": "node ./scripts/check-config.mjs",
    "test": "npm run test:lifecycle && npm run test:draft-run && npm run test:shared-run-storage && npm run test:shared-run-screen && npm run test:membership && npm run test:profiles && npm run test:activity && npm run test:screenshots && npm run lint && npm run typecheck && npm run config:check && npm run release:check && npm run test:ci-scope",
    "release:check": "node ./scripts/release-preflight.mjs",
    "test:lifecycle": "node --test ./tests/version-gate-lifecycle.test.cjs",
    "test:draft-run": "node --test ./tests/draft-run-race.test.cjs ./tests/draft-run-recovery.test.cjs",
    "test:shared-run-storage": "node --test ./tests/shared-run-storage.test.cjs",
    "test:shared-run-screen": "node --test ./tests/shared-run-screen.test.cjs ./tests/shared-run-home-resume.test.cjs",
    "test:membership": "node --test ./tests/membership.test.cjs",
    "test:profiles": "node --test ./tests/public-profile-api.test.cjs ./tests/profile-browsing.test.cjs ./tests/account-profile-save.test.cjs",
    "test:activity": "node --test ./tests/profile-activity.test.cjs ./tests/profile-activity-screen.test.cjs",
    "test:screenshots": "node --test ./tests/store-screenshot-contract.test.cjs",
    "test:ci-scope": "node --test ./tests/native-ci-scope.test.mjs ./tests/gradle-cache-key.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "expo-apple-authentication": "~57.0.2",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "expo-iap": "5.6.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "react-test-renderer": "19.2.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-iap"
        ]
      }
    }
  }
}
