.DS_Store
__pycache__/
*.pyc
*.csv
*.csv.gz
raw-data/
generated/
node_modules/
artifacts/

# Replay shards are intentionally not committed to git. They are durable data,
# not disposable runner output: rebuild workflows must checkpoint them to the
# model-versioned R2 namespace and verify them before a runner exits.
data/*/shards/

# Temporary credentials generated by google-github-actions/auth.
gha-creds-*.json
